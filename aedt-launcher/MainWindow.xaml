<Window x:Class="aedt_launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:aedt_launcher"
        mc:Ignorable="d"
        Title="AEDT Launcher" Height="145" Width="543" Loaded="Window_Loaded" Drop="Window_Drop" PreviewDragOver="Window_PreviewDragOver" ResizeMode="NoResize" WindowStyle="None">
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.QuitCommand}" Executed="QuitCommand_Executed"/>
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="Q" Modifiers="Control" Command="{x:Static local:MainWindow.QuitCommand}"/>
    </Window.InputBindings>
    <Grid>
        <TextBox x:Name="textBox_Filename" HorizontalAlignment="Left" Height="23" Margin="83,45,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="450"/>
        <TextBox x:Name="textBox_Type" HorizontalAlignment="Left" Height="23" Margin="83,73,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="152"/>
        <TextBox x:Name="textBox_Version" HorizontalAlignment="Left" Height="23" Margin="83,101,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="152"/>
        <Label x:Name="label_Filename" Content="File Name:" HorizontalAlignment="Left" Margin="12,42,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.526,0.115"/>
        <Label x:Name="label_Type" Content="Type:" HorizontalAlignment="Left" Margin="10,70,0,0" VerticalAlignment="Top"/>
        <Label x:Name="label_Version" Content="Version:" HorizontalAlignment="Left" Margin="10,101,0,0" VerticalAlignment="Top"/>
        <Button x:Name="button_Extract" Content="Extract" HorizontalAlignment="Left" Margin="378,104,0,0" VerticalAlignment="Top" Width="75" Click="button_Extract_Click"/>
        <Button x:Name="button_Launch" Content="Launch" HorizontalAlignment="Left" Margin="458,104,0,0" VerticalAlignment="Top" Width="75" Click="button_Launch_Click"/>
        <Image x:Name="appIcon" HorizontalAlignment="Left" Height="34" VerticalAlignment="Top" Width="34" Source="Images/032.ico"/>
        <Menu x:Name="mainMenu" HorizontalAlignment="Left" Height="34" Margin="39,0,0,0" VerticalAlignment="Top" Width="110">
            <MenuItem Header="File(_F)" Height="34" Width="55">
                <MenuItem Header="Quit" HorizontalAlignment="Left" Width="140" InputGestureText="Ctrl+Q" Command="{x:Static local:MainWindow.QuitCommand}" />
            </MenuItem>
            <MenuItem Header="Help(_H)" Height="34" Width="55">
                <MenuItem Header="About" HorizontalAlignment="Left" Width="140"/>
            </MenuItem>
        </Menu>
        <Button x:Name="clsButton" Content="X" HorizontalAlignment="Right" VerticalAlignment="Top" Width="34" Height="34" Click="clsButton_Click"/>
        <Image x:Name="titleBar" Height="34" Margin="149,0,78,0" VerticalAlignment="Top" Source="Images/title.png" Stretch="Fill" MouseLeftButtonDown="titleBar_MouseLeftButtonDown"/>
        <Button x:Name="minButton" Content="-" HorizontalAlignment="Left" Margin="470,0,0,0" VerticalAlignment="Top" Width="34" Height="34" Click="minButton_Click"/>

    </Grid>
</Window>
